{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.github.io/radarbr/data/transito.schema.json",
  "title": "RadarBR — Acidentes de Trânsito por Cidade (Feed Horário Grokbot)",
  "description": "Formato JSON para o Grokbot atualizar acidentes de trânsito por hora em data/<cidade>/transito.json. Aceita objeto com 'ocorrencias' (ou 'acidentes') ou array direto.",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/$defs/acidente" }
    },
    {
      "type": "object",
      "properties": {
        "atualizado_em": {
          "type": "string",
          "description": "Data/hora ISO 8601 da última coleta (ex: 2026-11-24T14:00:00-04:00)."
        },
        "fonte": {
          "type": "string",
          "default": "Grokbot"
        },
        "cidade": {
          "type": "string",
          "description": "Cidade/UF (ex: Campo Grande - MS)."
        },
        "observacao": {
          "type": "string"
        },
        "ocorrencias": {
          "type": "array",
          "items": { "$ref": "#/$defs/acidente" }
        },
        "acidentes": {
          "type": "array",
          "items": { "$ref": "#/$defs/acidente" }
        }
      },
      "anyOf": [
        { "required": ["ocorrencias"] },
        { "required": ["acidentes"] }
      ]
    }
  ],
  "$defs": {
    "acidente": {
      "type": "object",
      "required": ["id", "data", "tipo", "titulo", "cidade", "bairro"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único estável (ex: midiamax-2026-11-24-13h-colisao-afonso-pena)."
        },
        "data": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Data do acidente ou publicação (YYYY-MM-DD)."
        },
        "hora": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$",
          "description": "Hora local do acidente ou publicação (HH:MM, ex: 13:20). Usado nos filtros de 1h, 6h, 12h e 24h."
        },
        "data_hora": {
          "type": "string",
          "description": "Alternativa combinada ISO 8601 (ex: 2026-11-24T13:20:00-04:00)."
        },
        "tipo": {
          "type": "string",
          "enum": [
            "fatal",
            "atropelamento",
            "moto",
            "colisao",
            "capotamento",
            "ciclista",
            "onibus_caminhao",
            "embriaguez",
            "rodovia",
            "outro"
          ]
        },
        "titulo": {
          "type": "string",
          "description": "Manchete curta e objetiva do acidente."
        },
        "cidade": {
          "type": "string"
        },
        "bairro": {
          "type": "string"
        },
        "endereco": {
          "type": "string",
          "description": "Rua, avenida, cruzamento ou km da rodovia (opcional)."
        },
        "lat": {
          "type": ["number", "null"]
        },
        "lng": {
          "type": ["number", "null"]
        },
        "precisao": {
          "type": "string",
          "enum": ["rua", "bairro"],
          "default": "bairro"
        },
        "gravidade": {
          "type": "string",
          "enum": ["fatal", "grave", "leve", "sem_vitimas"]
        },
        "nova": {
          "type": "boolean",
          "default": false
        },
        "fonte": {
          "type": "string",
          "description": "Portal ou órgão fonte (ex: Campo Grande News, Midiamax, G1 MS, PRF-MS)."
        },
        "link": {
          "type": "string"
        },
        "descricao": {
          "type": "string"
        }
      }
    }
  }
}
